{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-mlops-live-classroom",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-22",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "0060.kr", "custom_domain": true },
    { "pattern": "www.0060.kr", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CLASSROOMS", "class_name": "Classroom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Classroom"] }
  ],
  "observability": { "enabled": true }
}
